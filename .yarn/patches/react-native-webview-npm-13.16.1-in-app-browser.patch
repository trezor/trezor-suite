 #pragma mark - WKNavigationDelegate methods
 
+#if !TARGET_OS_OSX
+/**
+ * The host a JavaScript dialog is attributed to, or nil for a frame that has none.
+ *
+ * WebKit tells the delegate which frame called alert/confirm/prompt. A dialog titled with that
+ * frame's host cannot pass for a dialog of the app or of the page that embeds the frame; a
+ * third-party iframe asking for a PIN shows up as that iframe's host. A frame without an
+ * identifiable host (an opaque origin loaded from about:srcdoc or about:blank) could belong to any
+ * frame on the page, so it gets no native dialog at all.
+ */
+- (NSString *)dialogTitleForFrame:(WKFrameInfo *)frame
+{
+  NSString *originHost = frame.securityOrigin.host;
+  if (originHost.length > 0) {
+    return originHost;
+  }
+  NSString *requestHost = frame.request.URL.host;
+  if (requestHost.length > 0) {
+    return requestHost;
+  }
+  return nil;
+}
+#endif // !TARGET_OS_OSX
+
