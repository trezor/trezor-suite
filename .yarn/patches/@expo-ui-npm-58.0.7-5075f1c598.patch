(modifiers ? createViewModifierEventListener(modifiers) : undefined),\n    ...restProps,\n    skipPartiallyExpanded: props.skipPartiallyExpanded ?? false,\n    initialFullyExpanded: props.initialFullyExpanded ?? false,\n    onDismissRequest: () => {\n      onDismissRequest?.();\n    },\n    onDidPresent: () => {\n      onDidPresent?.();\n    },\n  };\n}\n\n/**\n * A custom drag handle slot for `ModalBottomSheet`.\n * Wrap any content to use as the sheet's drag handle.\n *\n * @platform android\n */\nfunction DragHandle(props: { children: ReactNode }) {\n  return <SlotNativeView slotName=\"dragHandle\">{props.children}</SlotNativeView>;\n}\n\n/**\n * A Material Design modal bottom sheet.\n */\nfunction ModalBottomSheetComponent(props: ModalBottomSheetProps) {\n  const { children, ...rest } = props;\n  // The whole sheet, drag handle included, is presented in its own window, so all of it is marked.\n  return (\n    <ModalBottomSheetNativeView {...transformProps(rest as ModalBottomSheetProps)}>\n      <PresentedContent>{children}</PresentedContent>\n    </ModalBottomSheetNativeView>\n  );\n}\n\nModalBottomSheetComponent.DragHandle = DragHandle;\n\nexport const ModalBottomSheet = ModalBottomSheetComponent;\n"],"names":["requireNativeView","PresentedContent","createViewModifierEventListener","SlotNativeView","ModalBottomSheetNativeView","transformProps","props","modifiers","onDismissRequest","onDidPresent","restProps","undefined","skipPartiallyExpanded","initialFullyExpanded","DragHandle","slotName","children","ModalBottomSheetComponent","rest","ModalBottomSheet"],"mappings":";AAAA,SAASA,iBAAiB,QAAQ,OAAO;AAIzC,SAASC,gBAAgB,QAAQ,gCAAgC;AAEjE,SAASC,+BAA+B,QAAQ,qBAAqB;AAOrE,MAAMC,iBAAqDH,kBAAkB,UAAU;AAwGvF,MAAMI,6BAAyEJ,kBAC7E,UACA;AAGF,SAASK,eAAeC,KAA4B;IAClD,MAAM,EAAEC,SAAS,EAAEC,gBAAgB,EAAEC,YAAY,EAAE,GAAGC,WAAW,GAAGJ;IACpE,OAAO;QACLC;QACA,GAAIA,YAAYL,gCAAgCK,aAAaI,SAAS;QACtE,GAAGD,SAAS;QACZE,uBAAuBN,MAAMM,qBAAqB,IAAI;QACtDC,sBAAsBP,MAAMO,oBAAoB,IAAI;QACpDL,kBAAkB;YAChBA