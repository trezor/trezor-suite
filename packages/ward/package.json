{
    "name": "@trezor/ward",
    "version": "1.0.0",
    "type": "module",
    "author": "Trezor <info@trezor.io>",
    "homepage": "https://github.com/trezor/trezor-suite/tree/develop/packages/ward",
    "description": "Merkle Patricia Trie proof computation and storage-provider contract for Trezor AuthDB (address database).",
    "license": "See LICENSE.md in repo root",
    "repository": {
        "type": "git",
        "url": "git://github.com/trezor/trezor-suite.git"
    },
    "bugs": {
        "url": "https://github.com/trezor/trezor-suite/issues"
    },
    "sideEffects": false,
    "publishConfig": {
        "main": "./lib/index.mjs",
        "types": "./lib/index.d.mts",
        "exports": {
            ".": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            },
            "./types": {
                "types": "./lib/types/index.d.mts",
                "default": "./lib/types/index.mjs"
            },
            "./proof": {
                "types": "./lib/proof/index.d.mts",
                "default": "./lib/proof/index.mjs"
            },
            "./mocks": {
                "types": "./lib/mocks/index.d.mts",
                "default": "./lib/mocks/index.mjs"
            },
            "./storage": {
                "types": "./lib/storage/index.d.mts",
                "default": "./lib/storage/index.mjs"
            },
            "./storage/sqlite": {
                "types": "./lib/storage/sqlite/index.d.mts",
                "default": "./lib/storage/sqlite/index.mjs"
            }
        }
    },
    "main": "src/index",
    "files": [
        "lib/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib",
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "test:unit": "yarn g:jest",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@noble/curves": "^2.2.0",
        "@noble/hashes": "^2.0.1"
    },
    "optionalDependencies": {
        "better-sqlite3": "^12.6.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.0"
    }
}
