{
    "name": "@trezor/connect-mobile",
    "version": "10.0.0-alpha.1",
    "license": "MIT",
    "sideEffects": false,
    "main": "src/index.ts",
    "publishConfig": {
        "main": "./lib/index.js",
        "types": "./lib/index.d.ts",
        "exports": {
            ".": {
                "import": {
                    "types": "./libESM/index.d.mts",
                    "default": "./libESM/index.mjs"
                },
                "require": {
                    "types": "./lib/index.d.ts",
                    "default": "./lib/index.js"
                }
            }
        }
    },
    "files": [
        "lib/",
        "libESM/"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "build:lib": "yarn build:lib:cjs && yarn build:lib:esm",
        "build:lib:cjs": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && yarn build:dts:bundle && ../../scripts/publish/replace-imports.sh ./lib cjs",
        "build:lib:esm": "yarn g:rimraf ./libESM && yarn g:tsc --build tsconfig.libESM.json && DTS_OUT_DIR=libESM yarn build:dts:bundle && ../../scripts/publish/replace-imports.sh ./libESM esm",
        "build:dts:bundle": "rollup -c rollup.dts.config.mjs && mv \"${DTS_OUT_DIR:-lib}/index.bundled.d.ts\" \"${DTS_OUT_DIR:-lib}/index.d.ts\"",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@trezor/connect-common": "workspace:^",
        "@trezor/utils": "workspace:^"
    },
    "devDependencies": {
        "rollup": "^4.60.1",
        "rollup-plugin-dts": "^6.4.1"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
