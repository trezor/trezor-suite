{
    "name": "@trezor/connect-web",
    "version": "10.0.0-alpha.1",
    "type": "module",
    "author": "Trezor <info@trezor.io>",
    "homepage": "https://github.com/trezor/trezor-suite/tree/develop/packages/connect-web",
    "description": "High-level javascript interface for Trezor hardware wallet in web environment.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/trezor/trezor-suite.git"
    },
    "bugs": {
        "url": "https://github.com/trezor/trezor-suite/issues"
    },
    "keywords": [
        "Trezor",
        "trezor-connect",
        "javascript"
    ],
    "sideEffects": false,
    "main": "src/index.ts",
    "publishConfig": {
        "main": "./lib/index.js",
        "types": "./lib/index.d.ts",
        "exports": {
            ".": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            },
            "./lib/impl/*": "./lib/impl/*"
        }
    },
    "files": [
        "lib/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "test:unit": "yarn g:jest",
        "type-check": "yarn g:tsc --build",
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib && DTS_OUT_DIR=lib yarn build:dts:inline",
        "build:dts:inline": "node ../../scripts/inline-devdep-types.mjs",
        "size": "size-limit",
        "size:why": "size-limit --why",
        "test:e2e": "yarn playwright install && yarn xvfb-maybe -- playwright test --config=./e2e/playwright.config.ts",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "size-limit": [
        {
            "name": "ESM entry (gzipped)",
            "path": "libESM/index.mjs",
            "limit": "155 KB",
            "gzip": true,
            "ignore": [
                "react",
                "react-native",
                "crypto",
                "stream",
                "fs",
                "path",
                "os",
                "http",
                "https",
                "zlib",
                "buffer",
                "util"
            ]
        },
        {
            "name": "CJS entry (gzipped)",
            "path": "lib/index.js",
            "limit": "230 KB",
            "gzip": true,
            "ignore": [
                "react",
                "react-native",
                "crypto",
                "stream",
                "fs",
                "path",
                "os",
                "http",
                "https",
                "zlib",
                "buffer",
                "util"
            ]
        }
    ],
    "dependencies": {
        "@trezor/connect-common": "workspace:*",
        "@trezor/utils": "workspace:*",
        "@trezor/websocket-client": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "1.60.0",
        "@size-limit/esbuild": "^11.1.6",
        "@size-limit/file": "^11.1.6",
        "@trezor/eslint": "workspace:*",
        "@trezor/type-utils": "workspace:*",
        "@types/chrome": "^0.1.40",
        "@types/jest": "30.0.0",
        "@types/w3c-web-usb": "^1.0.14",
        "@types/web": "^0.0.345",
        "size-limit": "^11.1.6",
        "xvfb-maybe": "^0.2.1"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
