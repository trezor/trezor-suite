        "@sentry/webpack-plugin": "^4.6.1",
        "@trezor/type-utils": "workspace:*",
        "@types/electron-localshortcut": "^3.1.3",
        "electron": "39.0.0",
        "electron-devtools-installer": "^4.0.0",
        "glob": "^11.0.3",
        "lodash": "^4.17.21",
        "terser-webpack-plugin": "^5.3.14",
        "webpack": "5.102.1"
