{
    "name": "@trezor/connect-plugin-ethereum",
    "version": "10.0.0-beta.1",
    "type": "module",
    "author": "Trezor <info@trezor.io>",
    "homepage": "https://github.com/trezor/trezor-suite/tree/develop/packages/connect-plugin-ethereum",
    "description": "DEPRECATED — EIP-712 hash construction is now handled internally by @trezor/connect@10. See README for migration.",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": {
        "type": "git",
        "url": "git://github.com/trezor/trezor-suite.git"
    },
    "bugs": {
        "url": "https://github.com/trezor/trezor-suite/issues"
    },
    "keywords": [
        "Trezor",
        "trezor-connect",
        "Ethereum"
    ],
    "sideEffects": false,
    "publishConfig": {
        "main": "./lib/index.js",
        "types": "./lib/index.d.ts",
        "exports": {
            ".": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        }
    },
    "main": "src/index.ts",
    "files": [
        "lib/",
        "CHANGELOG.md"
    ],
    "peerDependencies": {
        "tslib": "^2.6.2"
    },
    "scripts": {
        "type-check": "yarn g:tsc --build tsconfig.json",
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib",
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    }
}
