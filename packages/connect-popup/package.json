{
    "name": "@trezor/connect-popup",
    "version": "9.0.0",
    "private": true,
    "sideEffects": false,
    "scripts": {
        "lint:styles": "npx stylelint './src/**/*{.ts,.tsx}' --cache --config ../../.stylelintrc",
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "dev": "yarn g:rimraf build && TS_NODE_PROJECT=\"tsconfig.json\" yarn webpack --config ./webpack/dev.webpack.config.ts",
        "build:popup": "TS_NODE_PROJECT=\"tsconfig.json\" yarn webpack --config ./webpack/prod.webpack.config.ts",
        "build": "yarn g:rimraf build && yarn core:popup && yarn workspace @trezor/connect-popup build:popup",
        "core:popup": "PROJECT=\"popup\" yarn workspace @trezor/connect-iframe build:core-module",
        "test:e2e": "yarn xvfb-maybe -- playwright test --config=./e2e/playwright.config.ts",
        "test:unit": "yarn g:jest"
    },
    "dependencies": {
        "@trezor/components": "workspace:*",
        "@trezor/connect": "workspace:*",
        "@trezor/connect-common": "workspace:*",
        "@trezor/connect-iframe": "workspace:*",
        "@trezor/connect-ui": "workspace:*",
        "@trezor/crypto-utils": "workspace:*",
        "@trezor/device-utils": "workspace:*",
        "@trezor/transport": "workspace:*",
        "@trezor/urls": "workspace:*",
        "@trezor/utils": "workspace:*",
        "eth-phishing-detect": "^1.2.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.28.5",
        "@babel/preset-typescript": "^7.28.5",
        "@playwright/browser-chromium": "1.55.0",
        "@playwright/browser-firefox": "1.55.0",
        "@playwright/browser-webkit": "1.55.0",
        "@playwright/test": "1.55.0",
        "@trezor/eslint": "workspace:*",
        "@trezor/node-utils": "workspace:*",
        "@trezor/trezor-user-env-link": "workspace:*",
        "@trezor/type-utils": "workspace:*",
        "@types/jest": "29.5.12",
        "@types/react": "^19.0.0",
        "@types/w3c-web-usb": "^1.0.10",
        "@types/web": "^0.0.197",
        "babel-loader": "^10.0.0",
        "copy-webpack-plugin": "^13.0.1",
        "crypto-browserify": "3.12.0",
        "html-webpack-plugin": "5.6.4",
        "rimraf": "^6.0.1",
        "stream-browserify": "^3.0.0",
        "terser-webpack-plugin": "^5.3.14",
        "vm-browserify": "^1.1.2",
        "webpack": "5.102.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.2",
        "webpack-merge": "^6.0.1",
        "webpack-plugin-serve": "^1.6.0",
        "worker-loader": "^3.0.8",
        "xvfb-maybe": "^0.2.1"
    },
    "peerDependencies": {
        "postcss-styled-syntax": "^0.7.1",
        "react": "19.1.0",
        "styled-components": "^6.1.19",
        "stylelint": "^16.19.0",
        "stylelint-config-standard": "^38.0.0"
    }
}
