        "paths": {
            "@trezor/theme": [
                "./packages/theme/src/*"
            ]
        },
        "plugins": [
            { "name": "typescript-styled-plugin" }
        ],
        "outDir": "./libDev"
    },
    "include": [".", "**/*.json"],
