        "yup": "1.7.1",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@storybook/react": "^10.6.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@trezor/eslint": "workspace:*",
        "@types/react": "19.2.14",
        "@types/zxcvbn": "4.4.5",
        "postcss-styled-syntax": "^0.7.3",
        "storybook": "^10.6.2",
        "stylelint": "^17.16.0",
