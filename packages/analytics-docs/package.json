{
    "name": "@trezor/analytics-docs",
    "private": true,
    "type": "module",
    "scripts": {
        "build-data": "tsx ./scripts/buildData.ts",
        "test:unit": "yarn g:jest -c ./jest.config.cjs",
        "dev": "[ -f public/analytics.json ] || yarn build-data; vite",
        "build": "yarn build-data && vite build",
        "preview": "vite preview",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@suite-common/analytics": "workspace:*",
        "@trezor/components": "workspace:*",
        "@trezor/eslint": "workspace:*",
        "@trezor/icons": "workspace:*",
        "@trezor/react-utils": "workspace:*",
        "@trezor/theme": "workspace:*",
        "@trezor/utils": "workspace:*",
        "@vitejs/plugin-react": "^6.1.2",
        "date-fns": "^4.1.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "styled-components": "^6.5.3",
        "ts-morph": "^28.0.0",
        "vite": "^8.3.3",
        "vite-plugin-node-polyfills": "^0.28.0"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "@types/react-dom": "19.3.0",
        "tsx": "^4.21.0"
    }
}
