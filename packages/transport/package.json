{
    "name": "@trezor/transport",
    "version": "10.0.0-alpha.1",
    "description": "Low level library facilitating protocol buffers based communication with Trezor devices",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/trezor/trezor-suite.git"
    },
    "bugs": {
        "url": "https://github.com/trezor/trezor-suite/issues"
    },
    "keywords": [
        "Trezor",
        "transport"
    ],
    "main": "./src/index.ts",
    "browser": {
        "./src/pinger/ping": "./src/pinger/ping.browser.ts",
        "./src/transports/nodeusb": "./src/transports/nodeusb.browser.ts",
        "./src/transports/udp": "./src/transports/udp.browser.ts",
        "./src/transports/webusb": "./src/transports/webusb.browser.ts"
    },
    "react-native": {
        "./src/transports/nodeusb": "./src/transports/nodeusb.native.ts",
        "./src/transports/webusb": "./src/transports/webusb.ts"
    },
    "publishConfig": {
        "main": "./libESM/index.mjs",
        "types": "./libESM/index.d.mts",
        "type": "module",
        "exports": {
            ".": {
                "types": "./libESM/index.d.mts",
                "default": "./libESM/index.mjs"
            },
            "./libESM/*": "./libESM/*",
            "./libESM/thp": {
                "types": "./libESM/thp/index.d.mts",
                "default": "./libESM/thp/index.mjs"
            },
            "./libESM/types": {
                "types": "./libESM/types/index.d.mts",
                "default": "./libESM/types/index.mjs"
            }
        },
        "browser": {
            "./libESM/pinger/ping": "./libESM/pinger/ping.browser.mjs",
            "./libESM/transports/nodeusb": "./libESM/transports/nodeusb.browser.mjs",
            "./libESM/transports/udp": "./libESM/transports/udp.browser.mjs",
            "./libESM/transports/webusb": "./libESM/transports/webusb.browser.mjs"
        },
        "react-native": {
            "./libESM/transports/nodeusb": "./libESM/transports/nodeusb.native.mjs",
            "./libESM/transports/webusb": "./libESM/transports/webusb.mjs"
        }
    },
    "files": [
        "libESM/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "build:lib": "yarn g:rimraf ./libESM && yarn g:tsc --build tsconfig.libESM.json && ../../scripts/publish/replace-imports.sh ./libESM esm",
        "publish:lib": "./scripts/publish-lib.sh",
        "test:unit": "jest",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "devDependencies": {
        "@babel/preset-env": "7.29.2",
        "@babel/preset-typescript": "^7.28.5",
        "@trezor/eslint": "workspace:*",
        "@types/bytebuffer": "^5.0.49",
        "@types/node": "22.13.10",
        "@types/sharedworker": "^0.0.223",
        "@types/w3c-web-usb": "^1.0.14",
        "jest": "29.7.0"
    },
    "dependencies": {
        "@trezor/protobuf": "workspace:*",
        "@trezor/protocol": "workspace:*",
        "@trezor/type-utils": "workspace:*",
        "@trezor/utils": "workspace:*",
        "cross-fetch": "^4.1.0",
        "usb": "^2.17.0"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
