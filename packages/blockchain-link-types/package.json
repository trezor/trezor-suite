{
    "name": "@trezor/blockchain-link-types",
    "version": "1.3.0",
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index.ts",
    "publishConfig": {
        "main": "lib/index.js"
    },
    "files": [
        "lib/",
        "!**/*.map"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/replace-imports.sh ./lib",
        "prepublishOnly": "yarn tsx ../../scripts/prepublishNPM.js",
        "prepublish": "yarn tsx ../../scripts/prepublish.js",
        "generate:blockbook-api": "",
        "generate:blockbook-api-schema": "yarn workspace @trezor/schema-utils codegen $(pwd)/src/blockbook-api.ts > src/blockbook-api-schema.ts && yarn g:eslint --fix src/blockbook-api-schema.ts && yarn g:prettier --write src/blockbook-api-schema.ts"
    },
    "dependencies": {
        "@solana/web3.js": "^2.0.0",
        "@trezor/schema-utils": "workspace:*",
        "@trezor/type-utils": "workspace:*",
        "@trezor/utxo-lib": "workspace:*"
    },
    "devDependencies": {
        "tsx": "^4.16.3"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
