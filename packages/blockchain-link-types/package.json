{
    "name": "@trezor/blockchain-link-types",
    "version": "10.0.0-beta.1",
    "type": "module",
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index.ts",
    "publishConfig": {
        "main": "./lib/index.js",
        "types": "./lib/index.d.ts",
        "exports": {
            ".": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            },
            "./lib/*": "./lib/*",
            "./lib/constants": {
                "types": "./lib/constants/index.d.ts",
                "default": "./lib/constants/index.js"
            }
        }
    },
    "files": [
        "lib/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib",
        "test:unit": "yarn g:jest --coverage -c jest.config.cjs",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@trezor/utils": "workspace:*",
        "@trezor/utxo-lib": "workspace:*",
        "socks-proxy-agent": "8.0.5"
    },
    "devDependencies": {
        "@trezor/type-utils": "workspace:*"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
