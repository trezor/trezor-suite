{
    "name": "@trezor/suite-build",
    "version": "1.0.0",
    "author": "Trezor <info@trezor.io>",
    "private": true,
    "keywords": [
        "Trezor",
        "suite-build"
    ],
    "license": "SEE LICENSE IN LICENSE.md",
    "description": "trezor suite build",
    "scripts": {
        "base": "TS_NODE_PROJECT=\"tsconfig.json\" webpack --config ./webpack.config.ts",
        "base:rspack": "TS_NODE_PROJECT=\"tsconfig.json\" rspack --config ./rspack.config.ts",
        "core:web": "PROJECT=\"suite-web\" yarn workspace @trezor/connect-iframe build:core-module",
        "web": "yarn run core:web && PROJECT=web yarn run base",
        "web:rspack": "yarn run core:web && PROJECT=web yarn run base:rspack",
        "dev:web": "yarn run web",
        "dev:web:rspack": "yarn run web:rspack",
        "build:web": "NODE_ENV=production yarn run web",
        "build:web:rspack": "NODE_ENV=production yarn run web:rspack",
        "desktop": "PROJECT=desktop yarn run base",
        "desktop:rspack": "PROJECT=desktop yarn run base:rspack",
        "dev:desktop": "yarn run desktop",
        "dev:desktop:rspack": "yarn run desktop:rspack",
        "build:desktop": "NODE_ENV=production yarn run desktop",
        "build:desktop:rspack": "NODE_ENV=production yarn run desktop:rspack",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "type-check:watch": "yarn type-check -- --watch"
    },
    "dependencies": {
        "@rspack/cli": "^1.1.6",
        "@rspack/core": "^1.1.6",
        "@suite-common/suite-config": "workspace:*",
        "@trezor/suite": "workspace:*",
        "babel-loader": "^9.1.3",
        "babel-plugin-styled-components": "^2.1.4",
        "copy-webpack-plugin": "^12.0.2",
        "crypto-browserify": "^3.12.0",
        "css-loader": "^6.10.0",
        "css-minimizer-webpack-plugin": "^6.0.0",
        "html-webpack-plugin": "^5.6.0",
        "raw-loader": "^4.0.2",
        "stream-browserify": "^3.0.0",
        "style-loader": "^3.3.4",
        "terser-webpack-plugin": "^5.3.9",
        "webpack": "^5.96.1",
        "webpack-bundle-analyzer": "^4.10.1",
        "webpack-merge": "^6.0.1",
        "webpack-nano": "^1.1.1",
        "webpack-plugin-serve": "^1.6.0",
        "worker-loader": "^3.0.8"
    },
    "devDependencies": {
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
        "@rspack/plugin-react-refresh": "^1.0.1",
        "@sentry/webpack-plugin": "^2.22.7",
        "@trezor/eslint": "workspace:*",
        "@types/copy-webpack-plugin": "^10.1.0",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "@types/webpack-plugin-serve": "^1.4.6",
        "react-refresh": "^0.16.0"
    }
}
