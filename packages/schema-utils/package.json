{
    "name": "@trezor/schema-utils",
    "version": "1.4.0",
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index.ts",
    "type": "module",
    "publishConfig": {
        "exports": {
            ".": {
                "import": "./libESM/index.js",
                "types": "./libESM/index.d.ts"
            }
        }
    },
    "npmPublishAccess": "public",
    "files": [
        "libESM/"
    ],
    "scripts": {
        "test:unit": "yarn g:jest",
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "build:lib": "yarn g:rimraf ./libESM && yarn g:tsc --build tsconfig.libESM.json && ../../scripts/publish/replace-imports.sh ./libESM esm",
        "codegen": "ts-node --skip-project ./src/codegen.ts",
        "prepublishOnly": "yarn tsx ../../scripts/publish/prepublishNPM.js",
        "prepublish": "yarn tsx ../../scripts/publish/prepublish.js"
    },
    "devDependencies": {
        "@sinclair/typebox-codegen": "^0.10.4",
        "@trezor/eslint": "workspace:*",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.3"
    },
    "dependencies": {
        "@sinclair/typebox": "^0.33.7",
        "ts-mixer": "^6.0.3"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
