{
    "name": "@trezor/connect-webextension",
    "version": "1.0.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "extension-popup.html"
    },
    "background": {
        "service_worker": "serviceWorker.bundle.js",
        "type": "module"
    },
    "externally_connectable": {
        "ids": [],
        "matches": ["https://*.trezor.io/*", "http://localhost/*", "https://*.suite.sldev.cz/*"]
    },
    "host_permissions": [
        "https://*.trezor.io/*",
        "http://localhost/*",
        "https://*.suite.sldev.cz/*"
    ]
}
