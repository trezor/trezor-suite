{
    "name": "@trezor/connect-explorer",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "dev": "NODE_OPTIONS=\"--no-experimental-global-navigator\" next -p 8088",
        "build": "NODE_OPTIONS=\"--no-experimental-global-navigator\" next build && rm -rf build && mv out build",
        "build:webextension": "BUILD_TARGET=webextension yarn build && yarn g:rimraf build-webextension && TS_NODE_PROJECT=\"tsconfig.json\" yarn webpack --config ./webpack/webextension.webpack.config.ts && bash ./webpack/replace-next-filenames.sh",
        "lint:styles": "stylelint './src/**/*{.ts,.tsx}' --cache --config ../../.stylelintrc",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@codemirror/state": "^6.6.0",
        "@hbsnow/rehype-sectionize": "^1.0.7",
        "@sinclair/typebox": "^0.34.49",
        "@trezor/components": "workspace:^",
        "@trezor/connect-common": "workspace:^",
        "@trezor/connect-data": "workspace:^",
        "@trezor/connect-explorer-theme": "workspace:^",
        "@trezor/connect-mobile": "workspace:^",
        "@trezor/connect-web": "workspace:^",
        "@trezor/connect-webextension": "workspace:^",
        "@trezor/device-authenticity": "workspace:^",
        "@trezor/icons": "workspace:*",
        "@trezor/protobuf": "workspace:^",
        "@trezor/schema-utils": "workspace:^",
        "@trezor/theme": "workspace:^",
        "@trezor/urls": "workspace:^",
        "@trezor/utils": "workspace:^",
        "@uiw/react-codemirror": "^4.25.9",
        "codemirror-json-schema": "^0.8.1",
        "codemirror-json5": "^1.0.3",
        "json5": "^2.2.3",
        "next": "15.5.21",
        "next-themes": "^0.4.6",
        "nextra": "patch:nextra@npm%3A2.13.4#~/.yarn/patches/nextra-npm-2.13.4-f23661e7e1.patch",
        "nextra-theme-docs": "^2.13.4",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-inspector": "^6.0.2",
        "react-markdown": "^10.1.0",
        "react-medium-image-zoom": "^5.4.0",
        "react-redux": "9.3.0",
        "redux": "^5.0.1",
        "redux-logger": "^3.0.6",
        "redux-thunk": "^3.1.0",
        "remark-gemoji": "^8.0.0",
        "remark-gfm": "^4.0.1",
        "styled-components": "^6.3.9",
        "stylelint": "^17.1.1",
        "stylelint-config-standard": "^40.0.0",
        "swr": "^2.4.1"
    },
    "devDependencies": {
        "@trezor/eslint": "workspace:*",
        "@types/chrome": "^0.2.2",
        "@types/node": "22.13.10",
        "@types/redux-logger": "^3.0.13",
        "@types/web": "^0.0.345",
        "babel-plugin-styled-components": "^2.1.4",
        "copy-webpack-plugin": "^14.0.0",
        "eslint-plugin-mdx": "^3.8.1",
        "html-webpack-plugin": "5.6.8",
        "rimraf": "^6.1.2",
        "typescript-styled-plugin": "^0.18.3",
        "webpack": "5.109.0",
        "webpack-cli": "^7.2.1"
    }
}
