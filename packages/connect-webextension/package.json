{
    "name": "@trezor/connect-webextension",
    "version": "10.0.0-beta.1",
    "type": "module",
    "author": "Trezor <info@trezor.io>",
    "homepage": "https://github.com/trezor/trezor-suite/tree/develop/packages/connect-webextension",
    "description": "High-level javascript interface for Trezor hardware wallet in webextension serviceworker environment.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/trezor/trezor-suite.git"
    },
    "bugs": {
        "url": "https://github.com/trezor/trezor-suite/issues"
    },
    "keywords": [
        "Trezor",
        "trezor-connect",
        "javascript",
        "serviceworker",
        "webextension"
    ],
    "main": "src/index.ts",
    "publishConfig": {
        "main": "./lib/index.js",
        "types": "./lib/index.d.ts",
        "exports": {
            ".": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        }
    },
    "files": [
        "lib/",
        "CHANGELOG.md",
        "!lib/proxy"
    ],
    "types": "src/index.ts",
    "scripts": {
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib && DTS_OUT_DIR=lib yarn build:dts:inline",
        "build:dts:inline": "node ../../scripts/inline-devdep-types.mjs",
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@trezor/connect-common": "workspace:*",
        "@trezor/connect-web": "workspace:*"
    },
    "devDependencies": {
        "@babel/preset-typescript": "^7.29.7",
        "@trezor/eslint": "workspace:*",
        "@types/chrome": "^0.1.40",
        "@types/w3c-web-usb": "^1.0.14",
        "babel-loader": "^10.1.1",
        "rimraf": "^6.1.2",
        "worker-loader": "^3.0.8"
    },
    "peerDependencies": {
        "tslib": "^2.6.2"
    }
}
