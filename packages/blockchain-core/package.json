{
    "name": "@trezor/blockchain-core",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "description": "Blockchain backends of Trezor Suite, next to Connect.",
    "sideEffects": false,
    "main": "src/index.ts",
    "browser": {
        "./src/workers/workers": "./src/workers/workers.browser.ts"
    },
