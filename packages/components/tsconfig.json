{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "paths": {
            "@trezor/theme": [
                "./packages/theme/src/*"
            ]
        },
        "plugins": [
            { "name": "typescript-styled-plugin" }
        ],
        "outDir": "./libDev"
    },
    "include": [".", "**/*.json"],
    "references": [
