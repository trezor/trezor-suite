{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "@trezor/theme": [
                "./packages/theme/src/*"
            ]
        },
        "plugins": [
            {
                "name": "typescript-styled-plugin",
                "tags": [
                    "styled",
                    "css",
                    "keyframes"
                ]
            }
        ],
        "outDir": "./libDev"
    },
    "include": [".", "**/*.json"],
    "references": [
        { "path": "../../suite-common/flags" },
        {
            "path": "../../suite-common/illustrations"
        },
        { "path": "../env-utils" },
        { "path": "../icons" },
        { "path": "../theme" },
        { "path": "../type-utils" },
        { "path": "../utils" },
        { "path": "../eslint" }
    ]
}
