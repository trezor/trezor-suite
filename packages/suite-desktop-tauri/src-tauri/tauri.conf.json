{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Trezor Suite Tauri",
    "version": "26.8.0",
    "identifier": "io.trezor.suite.tauri",
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": [
                    "trezorsuite",
                    "bitcoin",
                    "litecoin",
                    "bitcoincash",
                    "bitcoingold",
                    "dash",
                    "digibyte",
                    "dogecoin",
                    "namecoin",
                    "vertcoin",
                    "zcash"
                ]
            }
        }
    },
    "build": {
        "frontendDist": "../build",
        "devUrl": "http://localhost:8000"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src data: blob: *; img-src 'self' blob: data: https://*.trezor.io; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "resources": ["tor/**/*", "bluetooth/**/*"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
