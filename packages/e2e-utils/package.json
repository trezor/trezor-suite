{
    "name": "@trezor/e2e-utils",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build",
        "test-health": "tsx ./src/quarantineBot/index.ts",
        "select-tests": "tsx ./src/testCoverage/selectTestsByChangedFiles.ts",
        "build-coverage-map": "tsx ./src/testCoverage/buildCoverageMap.ts",
        "seed-tests": "CURRENTS_PROJECT_ID=iBEsWE yarn pwc --config ./src/quarantineBot/seed/playwright.config.ts",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "analyze-tests": "tsx ./src/llmTestAnalyzer/index.ts",
        "select-tests-llm": "tsx ./src/llmTestSelector/index.ts",
        "fix-bot:analyze": "tsx src/fixBot/analyze.ts",
        "fix-bot:fix": "tsx src/fixBot/fix.ts",
        "fix-bot:publish": "tsx src/fixBot/publish.ts",
        "fix-bot:notify": "tsx src/fixBot/notify.ts",
        "fix-bot:update-ledger": "tsx src/fixBot/ledger.ts",
        "gh-pr-stats": "tsx ./src/ghPrStats/index.ts",
        "github:create:project": "tsx src/githubReporter/scriptCreateProject.ts",
        "reporter-watchdog:wipe": "tsx src/githubReporter/watchdog/wipe.ts",
        "reporter-watchdog:verify": "tsx src/githubReporter/watchdog/verify.ts"
    },
    "dependencies": {
        "@octokit/rest": "^21.1.1",
        "@trezor/node-utils": "workspace:*",
        "@trezor/trezor-user-env-link": "workspace:*",
        "@trezor/utils": "workspace:*",
        "dotenv": "17.2.3",
        "express": "^5.2.1",
        "ws": "^8.20.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@anthropic-ai/claude-agent-sdk": "0.3.218",
        "@anthropic-ai/claude-code": "2.1.218",
        "@anthropic-ai/sdk": "0.100.0",
        "@currents/mcp": "^2.3.3",
        "@currents/playwright": "^2.5.0",
        "@playwright/test": "1.62.1",
        "@trezor/eslint": "workspace:*",
        "claude-pretty-printer": "1.5.0",
        "tsx": "^4.21.0"
    }
}
