{
    "name": "@suite/web-app",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "type-check:watch": "yarn type-check -- --watch",
        "lint:styles": "stylelint './src/**/*{.ts,.tsx}' --cache --config ../../.stylelintrc",
        "dev": "yarn rimraf ./build && TS_NODE_PROJECT=\"tsconfig.json\" webpack --config ./webpack.config.ts",
        "dev:vite": "yarn rimraf ./build && vite",
        "analyze": "ANALYZE=true yarn build",
        "build": "yarn rimraf ./build && NODE_ENV=production TS_NODE_PROJECT=\"tsconfig.json\" webpack --config ./webpack.config.ts",
        "preview": "vite preview -c ./preview.vite.config.mts --outDir ./build --mode production",
        "build:preview": "yarn build && yarn preview",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'"
    },
    "dependencies": {
        "@sentry/browser": "10.69.0",
        "@suite-common/dependency-injection": "workspace:*",
        "@suite-common/redux-utils": "workspace:*",
        "@suite-common/suite-utils": "workspace:*",
        "@suite/debug": "workspace:*",
        "@suite/desktop-app-api": "workspace:*",
        "@suite/platform-encryption-webauthn": "workspace:*",
        "@suite/router": "workspace:*",
        "@trezor/connect": "workspace:*",
        "@trezor/connect-common": "workspace:*",
        "@trezor/env-utils": "workspace:*",
        "@trezor/suite": "workspace:*",
        "@trezor/transport-common": "workspace:*",
        "@trezor/transport-web": "workspace:*",
        "@trezor/utils": "workspace:*",
        "core-js": "^3.49.0",
        "history": "^5.3.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-redux": "9.3.0"
    },
    "devDependencies": {
        "@originjs/vite-plugin-commonjs": "^1.0.3",
        "@rolldown/plugin-babel": "^0.2.1",
        "@suite-common/flags": "workspace:*",
        "@suite-common/suite-config": "workspace:*",
        "@suite/router-config": "workspace:*",
        "@suite/sentry": "workspace:*",
        "@trezor/connect": "workspace:*",
        "@trezor/eslint": "workspace:*",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "copy-webpack-plugin": "^14.0.0",
        "crypto-browserify": "3.12.1",
        "html-webpack-plugin": "5.6.8",
        "lottie-react": "2.4.1",
        "lottie-web": "^5.10.2",
        "postcss-styled-syntax": "^0.7.1",
        "rimraf": "^6.1.2",
        "stream-browserify": "^3.0.0",
        "stylelint": "^17.1.1",
        "stylelint-config-standard": "^40.0.0",
        "tsx": "^4.21.0",
        "vite": "^8.0.7",
        "vite-plugin-wasm": "^3.6.0",
        "vm-browserify": "^1.1.2",
        "webpack": "5.110.1",
        "webpack-cli": "^7.2.1",
        "webpack-merge": "^6.0.1"
    }
}
