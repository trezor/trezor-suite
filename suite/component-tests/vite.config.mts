import react from '@vitejs/plugin-react';
import { resolve } from 'path';
import { type Plugin, defineConfig } from 'vite';

import { noopCoreJsPlugin, sharedAliases } from '@trezor/suite-build/viteShared';

import { GALLERY_PORT } from './galleryServer';

const repoRoot = resolve(__dirname, '../..');

/**
 * The autogenerated asset maps in `@suite-common/{icons,flags,illustrations}` and
 * `@trezor/product-components` address assets with CommonJS `require('./x.svg')`, which Vite leaves
 * as a bare `require` for the browser to choke on. The app build handles these with
 * `viteCommonjs()`, which this gallery does not run — do not narrow this to the app's
 * `trezorLogosRequirePlugin` scope, which relies on that plugin for everything else.
 *
 * Scoped to those packages: `transform` runs for every module in the graph, and the regex scan
 * would be wasted on the thousands of sources that merely mention `require(`.
 */
const assetRequireDirs = [
    'suite-common/icons',
    'suite-common/flags',
    'suite-common/illustrations',
    'packages/product-components',
].map(dir => `${resolve(repoRoot, dir)}/`);

const requireAssetPlugin = (): Plugin => ({
    name: 'require-asset-to-url',
    enforce: 'pre',
    transform(code, id) {
        const cleanId = id.split('?')[0] ?? id;
        const isAssetPackageSource = assetRequireDirs.some(dir => cleanId.startsWith(dir));
        if (!isAssetPackageSource || !code.includes('require(')) {
            return null;
        }

        return {
            code: code.replace(
                /require\((['"`])([^'"`]+\.(?:svg|png|gif|jpe?g|webp))\1\)/g,
                'new URL($1$2$1, import.meta.url).href',
            ),
            map: null,
        };
    },
});

/* eslint-disable-next-line import/no-default-export */
export default defineConfig({
    root: resolve(__dirname, 'gallery'),
    cacheDir: resolve(repoRoot, 'node_modules/.vite-component-tests'),
    plugins: [requireAssetPlugin(), noopCoreJsPlugin(), react()],
    // `dedupe` is what keeps `preserveSymlinks` from resolving react under more than one id: the
    // renderer would land in the entry chunk with one copy while the story chunks share another,
    // and every story then dies on "Invalid hook call".
    resolve: {
        alias: sharedAliases,
        preserveSymlinks: true,
        dedupe: ['react', 'react-dom'],
    },
    define: {
        'process.browser': true,
        'process.env.NODE_ENV': JSON.stringify('development'),
        'process.env.SUITE_TYPE': JSON.stringify('web'),
        'process.env.VERSION': JSON.stringify('0.0.0-component-tests'),
        'process.env.COMMIT_HASH': JSON.stringify('component-tests'),
        'process.env.ASSET_PREFIX': JSON.stringify(''),
        global: 'globalThis',
        __DEV__: true,
    },
    build: { outDir: resolve(__dirname, 'dist-gallery'), emptyOutDir: true },
    server: { port: GALLERY_PORT, host: true, strictPort: true, fs: { allow: [repoRoot] } },
    preview: { port: GALLERY_PORT, host: true, strictPort: true },
});
