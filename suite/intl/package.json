{
    "name": "@suite/intl",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index",
    "types": "./libDev/src/index.d.ts",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "translations:format": "yarn g:prettier --write \"../../packages/suite-data/files/translations/*\"",
        "translations:extract": "formatjs extract src/messages.ts --format simple > ../../packages/suite-data/files/translations/master.json",
        "translations:upload": "crowdin upload",
        "translations:download": "crowdin download --all -l en -l es-ES -l cs -l de -l fr -l hu -l it -l ja -l ko -l pt-BR -l ru -l tr -l uk -l zh-CN -l zh-TW",
        "translations:backport-en": "yarn g:tsx ../../packages/suite-data/src/translations/backport-en.ts && yarn g:prettier --write \"./src/messages.ts\"",
        "translations:list-duplicates": "yarn g:tsx ../../packages/suite-data/src/translations/list-duplicates.ts",
        "translations:list-unused": "yarn g:tsx ../../packages/suite-data/src/translations/list-unused.ts",
        "type-check": "yarn g:tsc --build tsconfig.typecheck.json"
    },
    "dependencies": {
        "@crowdin/cli": "4.13.0",
        "@formatjs/cli": "6.12.2",
        "@trezor/type-utils": "workspace:^",
        "react": "19.2.4",
        "react-intl": "^8.1.3"
    }
}
