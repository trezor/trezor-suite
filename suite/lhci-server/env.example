# Copy to .env (gitignored) and fill in — compose reads it automatically: cp env.example .env

# Public hostname the dashboard is served on. The DNS A record must point at this box before the
# first start, or Caddy's ACME certificate issuance will fail.
LHCI_HOST=perf-lhci.sldev.cz

# Postgres credentials. The DB is only reachable inside the compose network, but pick a real
# password anyway — it also guards the pg_dump backups. Letters and digits only: the password is
# interpolated into a postgres:// URL without encoding, so URL-reserved characters (@ : / ? # %)
# would crash-loop the lhci container.
POSTGRES_USER=lhci
POSTGRES_PASSWORD=
POSTGRES_DB=lhci

# Loopback port for the SSH-tunnel admin surface. Change only if 9001 is taken on the host.
#LHCI_ADMIN_PORT=9001

# Optional HTTP basic auth on EVERYTHING (dashboard + API). CI would then need the same
# credentials on every request — leave empty for the public-dashboard default: the server drops the
# auth middleware whenever the password is empty. The username defaults to "lhci". Both reach the
# server as LHCI_BASIC_AUTH__* env vars, never as command-line flags.
#BASIC_AUTH_USERNAME=
#BASIC_AUTH_PASSWORD=

# Local smoke test only (ports 80/443/9001 are usually taken on a dev machine):
#CADDY_HTTP_PORT=8080
#CADDY_HTTPS_PORT=8443
#LHCI_ADMIN_PORT=9011

# Loopback port the "dev" profile's db-forward publishes Postgres on, for a local GUI client. Read
# only by that profile — production never starts it, so the database stays inside the network.
#DB_LOCAL_PORT=5434
