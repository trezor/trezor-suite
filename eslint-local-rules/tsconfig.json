{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "rootDir": ".",
        "noImplicitAny": false,
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false
    },
    "include": ["./**/*.ts"]
}
