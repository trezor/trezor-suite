{
    "name": "@suite-native/storybook",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": ".rnstorybook/index",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "type-check": "yarn g:tsc --build",
        "storybook:generate": "sb-rn-get-stories",
        "storybook:web": "yarn setup-skia-web && storybook dev -p 6006",
        "storybook:web:build": "yarn setup-skia-web && yarn storybook build -c .storybook -o .build-storybook"
    },
    "dependencies": {
        "@gorhom/bottom-sheet": "5.2.9",
        "@lottiefiles/dotlottie-react": "0.20.0",
        "@react-native-community/datetimepicker": "9.2.1",
        "@react-native-community/slider": "5.2.1",
        "@react-navigation/native": "7.1.31",
        "@react-navigation/native-stack": "7.12.0",
        "@shopify/react-native-skia": "2.14.0",
        "@storybook/addon-ondevice-controls": "^10.6.0",
        "@storybook/react": "^10.6.1",
        "@storybook/react-native": "^10.6.0",
        "@storybook/react-native-web-vite": "^10.6.1",
        "@suite-native/alerts": "workspace:*",
        "@suite-native/intl": "workspace:*",
        "@trezor/eslint": "workspace:*",
        "@trezor/styles-native": "workspace:*",
        "@trezor/theme": "workspace:*",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0",
        "react-native-mmkv": "~4.3.2",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-web": "^0.21.0",
        "storybook": "^10.6.1",
        "vite": "^8.3.3",
        "vite-plugin-node-polyfills": "^0.28.0"
    }
}
