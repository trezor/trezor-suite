{
    "name": "@suite-native/storybook",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": ".rnstorybook/index",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "type-check": "yarn g:tsc --build",
        "storybook:generate": "sb-rn-get-stories",
        "storybook:web": "yarn setup-skia-web && storybook dev -p 6006",
        "storybook:web:build": "yarn setup-skia-web && yarn storybook build -c .storybook -o .build-storybook"
    },
    "dependencies": {
        "@gorhom/bottom-sheet": "5.2.8",
        "@lottiefiles/dotlottie-react": "^0.17.14",
        "@react-native-community/datetimepicker": "^8.6.0",
        "@react-native-community/slider": "^5.1.2",
        "@shopify/react-native-skia": "2.5.1",
        "@storybook/addon-ondevice-controls": "^10.2.1",
        "@storybook/react": "^10.3.4",
        "@storybook/react-native": "^10.2.1",
        "@storybook/react-native-web-vite": "^10.3.4",
        "@suite-native/alerts": "workspace:*",
        "@suite-native/intl": "workspace:*",
        "@trezor/eslint": "workspace:*",
        "@trezor/styles-native": "workspace:*",
        "@trezor/theme": "workspace:*",
        "babel-plugin-react-native-web": "^0.21.2",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-intl": "^8.1.3",
        "react-native": "0.83.2",
        "react-native-mmkv": "~4.3.0",
        "react-native-safe-area-context": "5.6.2",
        "react-native-web": "^0.21.0",
        "storybook": "^10.3.4",
        "vite": "^8.0.0",
        "vite-plugin-node-polyfills": "^0.26.0"
    }
}
