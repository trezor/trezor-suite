{
    "cli": {
        "version": ">= 7.1.1",
        "appVersionSource": "remote",
        "promptToConfigurePushNotifications": false
    },
    "build": {
        "develop": {
            "env": {
                "EXPO_PUBLIC_ENVIRONMENT": "develop",
                "EXPO_PUBLIC_CODESIGN_BUILD": "false"
            },
            "channel": "develop",
            "autoIncrement": true,
            "ios": {
                "distribution": "store"
            },
            "android": {
                "distribution": "internal",
                "resourceClass": "large"
            }
        },
        "preview": {
            "env": {
                "EXPO_PUBLIC_ENVIRONMENT": "preview",
                "EXPO_PUBLIC_CODESIGN_BUILD": "false"
            },
            "channel": "preview",
            "autoIncrement": true,
            "developmentClient": true,
            "credentialsSource": "remote",
            "node": "22.11.0",
            "ios": {
                "distribution": "store"
            },
            "android": {
                "distribution": "internal",
                "resourceClass": "large"
            }
        },
        "adhoc": {
            "extends": "preview",
            "developmentClient": false
        },
        "production": {
            "env": {
                "EXPO_PUBLIC_ENVIRONMENT": "production",
                "EXPO_PUBLIC_CODESIGN_BUILD": "true"
            },
            "autoIncrement": true,
            "credentialsSource": "remote",
            "android": {
                "resourceClass": "large"
            }
        },
        "productionAPK": {
            "env": {
                "EXPO_PUBLIC_ENVIRONMENT": "production",
                "EXPO_PUBLIC_CODESIGN_BUILD": "true"
            },
            "android": {
                "credentialsSource": "remote",
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "develop": {
            "ios": {
                "bundleIdentifier": "io.trezor.suite.develop",
                "ascAppId": "1632206646",
                "appleTeamId": "C3P22XVH2C"
            }
        },
        "preview": {
            "ios": {
                "bundleIdentifier": "io.trezor.suite.preview",
                "ascAppId": "6739429089",
                "appleTeamId": "C3P22XVH2C"
            }
        },
        "adhoc": {
            "extends": "preview"
        },
        "production": {
            "android": {
                "track": "internal",
                "changesNotSentForReview": true
            },
            "ios": {
                "bundleIdentifier": "io.trezor.suite",
                "ascAppId": "1631884497",
                "appleTeamId": "C3P22XVH2C"
            }
        }
    }
}
