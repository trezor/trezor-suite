{
    "name": "@trezor/coins-solana",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "./src/index.ts",
    "type": "module",
    "exports": {
        "./constants": "./src/constants/index.ts",
        "./runtime": "./src/runtime/index.ts",
        "./types": "./src/types/index.ts",
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "main": "./libESM/index.mjs",
        "types": "./libESM/index.d.mts",
        "exports": {
            "./constants": {
                "types": "./libESM/constants/index.d.mts",
                "default": "./libESM/constants/index.mjs"
            },
            "./runtime": {
                "types": "./libESM/runtime/index.d.mts",
                "default": "./libESM/runtime/index.mjs"
            },
            "./types": {
                "types": "./libESM/types/index.d.mts",
                "default": "./libESM/types/index.mjs"
            },
            ".": {
                "types": "./libESM/index.d.mts",
                "default": "./libESM/index.mjs"
            }
        }
    },
    "files": [
        "libESM/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "test:unit": "yarn g:jest --passWithNoTests",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "build:lib": "yarn g:rimraf ./libESM && yarn g:tsc --build tsconfig.libESM.json && ../../scripts/publish/replace-imports.sh ./libESM esm"
    },
    "dependencies": {
        "@solana-program/compute-budget": "^0.8.0",
        "@solana-program/memo": "^0.7.0",
        "@solana-program/stake": "^0.2.1",
        "@solana-program/system": "^0.7.0",
        "@solana-program/token": "^0.5.1",
        "@solana-program/token-2022": "^0.4.2",
        "@solana/kit": "^2.3.0",
        "@solana/rpc-api": "^2.3.0",
        "@solana/rpc-types": "^2.3.0",
        "@trezor/type-utils": "workspace:*",
        "@trezor/utils": "workspace:*"
    }
}
