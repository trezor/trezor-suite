{
    "name": "@trezor/coins-stellar",
    "version": "10.0.0-alpha.1",
    "license": "MIT",
    "sideEffects": false,
    "main": "./src/index.ts",
    "type": "module",
    "exports": {
        "./constants": "./src/constants/index.ts",
        "./runtime": "./src/runtime/index.ts",
        "./types": "./src/types/index.ts",
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "main": "./lib/index.mjs",
        "types": "./lib/index.d.mts",
        "exports": {
            "./constants": {
                "types": "./lib/constants/index.d.mts",
                "default": "./lib/constants/index.mjs"
            },
            "./runtime": {
                "types": "./lib/runtime/index.d.mts",
                "default": "./lib/runtime/index.mjs"
            },
            "./types": {
                "types": "./lib/types/index.d.mts",
                "default": "./lib/types/index.mjs"
            },
            ".": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            }
        }
    },
    "files": [
        "lib/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "test:unit": "yarn g:jest --passWithNoTests",
        "type-check": "yarn g:tsc --build tsconfig.json",
        "build:lib": "yarn g:rimraf ./lib && yarn g:tsc --build tsconfig.lib.json && ../../scripts/publish/replace-imports.sh ./lib"
    },
    "dependencies": {
        "@stellar/stellar-sdk": "14.5.0",
        "@trezor/utils": "workspace:*"
    }
}
