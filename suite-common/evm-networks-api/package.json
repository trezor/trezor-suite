{
    "name": "@suite-common/evm-networks-api",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "type-check": "yarn g:tsc --build",
        "test:unit": "yarn g:jest",
        "format": "prettier --write './**/*.{ts,json}'",
        "orval": "orval --config ./orval.config.ts",
        "api:generate": "yarn orval",
        "api:update": "yarn api:generate && yarn lint:js --fix && yarn format"
    },
    "dependencies": {
        "@suite-common/react-query": "workspace:^",
        "@trezor/env-utils": "workspace:*",
        "@trezor/redux-utils": "workspace:*",
        "@trezor/type-utils": "workspace:*",
        "@trezor/zod": "workspace:*"
    },
    "devDependencies": {
        "@suite-common/test-utils": "workspace:*",
        "orval": "8.46.0",
        "prettier": "^3.9.9"
    }
}
