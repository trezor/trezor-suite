{
    "$id": "https://data.trezor.io/suite/definitions/ranked.schema.v1.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Known tokens of every platform, ranked by market cap",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "properties": {
            "assetPlatformId": {
                "type": "string"
            },
            "address": {
                "type": "string"
            },
            "marketCap": {
                "type": "number",
                "exclusiveMinimum": 0
            }
        },
        "required": ["assetPlatformId", "address", "marketCap"]
    }
}
