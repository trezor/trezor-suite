{
    "$id": "https://data.trezor.io/suite/definitions/ranked.schema.v1.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Known tokens of every platform, ranked by market cap",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "properties": {
            "assetPlatformId": { "type": "string" },
            "address": { "type": "string" },
            "symbol": { "type": "string" },
            "name": { "type": "string" },
            "marketCap": { "type": "number", "minimum": 0 }
        },
        "required": ["assetPlatformId", "address", "symbol", "name", "marketCap"]
    }
}
