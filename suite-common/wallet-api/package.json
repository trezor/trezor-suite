{
    "name": "@suite-common/wallet-api",
    "version": "1.0.0",
    "private": true,
    "license": "See LICENSE.md in repo root",
    "sideEffects": false,
    "main": "src/index",
    "scripts": {
        "depcheck": "yarn g:depcheck",
        "lint:js": "yarn g:eslint '**/*.{ts,tsx,js}'",
        "type-check": "yarn g:tsc --build",
        "format": "prettier --write \"**/*.{ts,yaml,yml,json}\"",
        "orval": "orval --config ./orval.config.ts",
        "fetch-specs": "yarn g:tsx ./scripts/fetchSpec.ts",
        "generate-schemas": "yarn orval",
        "update-schemas": "yarn fetch-specs && yarn generate-schemas && yarn lint:js --fix && yarn format"
    },
    "dependencies": {
        "zod": "4.3.6"
    },
    "devDependencies": {
        "orval": "8.5.0",
        "prettier": "3.8.1"
    }
}
