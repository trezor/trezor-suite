# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-neo4j-secret

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=memory
POSTGRES_PASSWORD=changeme-postgres-secret
POSTGRES_DB=memory_gateway

# Gateway
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# JWT (placeholder – replace with real secret)
JWT_SECRET=changeme-jwt-secret

# Audit event retention (days)
AUDIT_RETENTION_DAYS=90

# Log level
LOG_LEVEL=info
