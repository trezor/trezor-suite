{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "expo": true,
    "jest": true,
    "mdx": true,
    "next": true,
    "playwright": true,
    "tsx": true,
    "vitest": true,
    "workspaces": {
        "packages/connect": {
            "entry": ["e2e/run.ts"]
        },
        "packages/connect-explorer": {
            "entry": ["next.config.mjs", "theme.config.tsx", "src/pages/**/*.mdx"]
        },
        "packages/protobuf": {
            "entry": [
                "scripts/protobuf-build.sh",
                "scripts/protobuf-*.ts",
                "scripts/protobuf-patches/index.ts",
                "scripts/protoc-gen-plugin.ts"
            ]
        },
        "suite-common/icons": {
            "entry": ["generateIcons.mjs", "generateIconFont.ts", "scripts/**/*.ts"]
        },
        "suite-common/token-definitions": {
            "entry": ["scripts/index.ts"]
        },
        "suite/e2e": {
            "entry": ["playwright-config/*.ts"]
        },
        "suite-native/app": {
            "entry": [
                ".detoxrc.js",
                "app.config.ts",
                "babel.config.js",
                "e2e/jest.config.js",
                "e2e/trezorDetoxRunner/config/*.js",
                "e2e/trezorDetoxRunner/index.ts",
                "jest.config.js"
            ],
            "metro": false
        }
    }
}
